{
  "$comment": "Keypad design-system adherence rules (from _adherence.oxlintrc.json), with component paths mapped to src/ds.",
  "plugins": ["react", "import"],
  "rules": {
    "no-restricted-imports": ["warn", { "patterns": [{ "group": ["**/ds/components/**"], "message": "Import design-system components from 'ds/index.js', not component internals." }] }],
    "no-restricted-syntax": ["warn",
      { "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]", "message": "Raw hex color — use a design-system color token via var()." },
      { "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|primary|success|danger|warning)$/]", "message": "<Badge> tone must be one of 'neutral' | 'primary' | 'success' | 'danger' | 'warning'." },
      { "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]", "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'." },
      { "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]", "message": "<Button> size must be one of 'sm' | 'md' | 'lg'." },
      { "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|danger)$/]", "message": "<Toast> tone must be one of 'neutral' | 'success' | 'danger'." }
    ]
  },
  "overrides": [{ "files": ["src/ds/**"], "rules": { "no-restricted-imports": "off", "no-restricted-syntax": "off" } }]
}
